# --- BigQuery (read-only: events, invoices, payouts) ---
# Base64-encoded service account JSON for naboo-app-365515.
BIG_QUERY_JSON=""

# --- Annotation store (comments, partner statuses, PO dates) ---
# Provisioned from Vercel → Storage → Postgres; Vercel injects this automatically
# on deploy. Only needed by hand for local development.
# The app creates its own tables on first run.
DATABASE_URL=""

# --- Google OAuth ---
# OAuth 2.0 Web client from the Naboo Google Cloud console.
# Authorized redirect URIs must include:
#   https://<your-domain>/api/auth/callback
#   http://localhost:5173/api/auth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Random secret for signing session cookies: openssl rand -base64 32
SESSION_SECRET=""
